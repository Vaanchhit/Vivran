APP_ENV=development
APP_NAME=Vivran

# Tier 1 - optional local AI (Ollama). Leave blank in production — Tier 1
# falls back to Gemini flash-lite automatically when this is unset/unreachable.
OLLAMA_HOST=
OLLAMA_MODEL=qwen2.5:7b

# Gemini API key — powers all three AI tiers (open/cheap/premium) and embeddings.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model overrides (defaults shown). PREMIUM_MODEL needs a Google Cloud
# billing account with Pro-tier quota — without it, the premium tier
# automatically falls back to the cheap tier (see app/generation/assessments.py).
OPEN_MODEL=gemini-3.6-flash
CHEAP_MODEL=gemini-3.6-flash
PREMIUM_MODEL=gemini-pro-latest

# Media Services (Cartesia / ElevenLabs) — optional, narration-audio only
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth JWT secret (Settings -> API -> JWT Secret)
# Used by the backend to validate access tokens from Supabase Auth.
SUPABASE_JWT_SECRET=replace-with-your-supabase-jwt-secret

# CORS (comma-separated explicit origins; wildcard + credentials is rejected by browsers)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
