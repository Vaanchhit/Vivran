APP_ENV=development
APP_NAME=Vivran

# --- AI providers -----------------------------------------------------------
# Gemini powers every tier and embeddings. https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq is the last-resort failover, used only when Gemini reports itself busy
# on both the primary and the fallback model. https://console.groq.com/keys
GROQ_API_KEY=

# Model pins live in app/core/config.py, with the benchmark behind each one
# (scripts/bench_models.py). Override only to test a different model:
# SLM_MODEL=gemini-3.5-flash-lite          # intent, classification, rewrites
# CHEAP_MODEL=gemini-3.5-flash-lite        # slides, worksheets, notes
# ASSESSMENT_MODEL=gemini-3.1-flash-lite   # exam papers
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# PREMIUM_MODEL=gemini-pro-latest          # needs Pro-tier billing
# PREMIUM_TIER_ENABLED=false

# --- Media (optional) -------------------------------------------------------
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=
# Tally.so MCQ-to-form export: Tally -> Settings -> API Keys.
TALLY_API_KEY=

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Settings -> API -> JWT Secret; validates Supabase Auth access tokens.
SUPABASE_JWT_SECRET=replace-with-your-supabase-jwt-secret

# CORS: comma-separated explicit origins (wildcard + credentials is rejected).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
