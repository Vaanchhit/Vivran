APP_ENV=development
APP_NAME=Vivran

# Tier 1 - Local AI (Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Tier 2 & Tier 3 Cloud AI
CHEAP_MODEL=gpt-4o-mini
PREMIUM_MODEL=gpt-4o

# Media Services (Cartesia / ElevenLabs)
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Auth JWT secret (Settings -> API -> JWT Secret)
# Used by the backend to validate access tokens from Supabase Auth.
SUPABASE_JWT_SECRET=replace-with-your-supabase-jwt-secret

# CORS (comma-separated explicit origins; wildcard + credentials is rejected by browsers)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
